# frontend/.env  (o .env en la raíz si Vite corre ahí)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_API_URL=http://localhost:8000
# Opcional, solo en entorno experimental Cognito:
# VITE_AUTH_PROVIDER=cognito
# VITE_COGNITO_POOL_ID=us-east-1_EXAMPLE
# VITE_COGNITO_CLIENT_ID=CLIENT_ID_PUBLICO
# VITE_REQUIRE_REAL_API=true
# Opcional: URL pública WebSocket de la pila AWS macro.
# VITE_MACRO_WS_URL=wss://ID.execute-api.REGION.amazonaws.com/prod
VITE_COGNITO_SELF_SIGNUP=false
VITE_YAHOO_OBSERVACIONES=false
