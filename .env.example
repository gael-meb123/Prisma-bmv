# --- Entorno -----------------------------------------------------------
PRISMA_ENV=development              # production exige PRISMA_MASTER_KEY
PRISMA_DATA_SOURCE=local            # local | s3 | athena
# PRISMA_DATA_DIR=./datos
# PRISMA_STATE_DIR=./.estado

# --- Seguridad -----------------------------------------------------------
# Genere con: python scripts/generar_llave_maestra.py
PRISMA_MASTER_KEY=
PRISMA_PBKDF2_ITER=600000
PRISMA_SEED_DEMO=true               # cuentas demo; desactivar en producción

# --- AWS -----------------------------------------------------------------
AWS_REGION=us-east-1
PRISMA_S3_BUCKET=prisma-bmv-datalake-CAMBIAR
PRISMA_ATHENA_DATABASE=prisma_bmv
PRISMA_ATHENA_WORKGROUP=primary
# PRISMA_ATHENA_OUTPUT=s3://prisma-bmv-datalake-CAMBIAR/athena-results/
# Credenciales: perfil de ~/.aws/credentials o AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN

# --- Prismi (Claude API) -------------------------------------------------
ANTHROPIC_API_KEY=
PRISMI_MODEL=claude-sonnet-5-5
PRISMI_EXPLORER_DAILY_QUOTA=5
