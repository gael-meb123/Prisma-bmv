{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerEscribirCapasDelLakehouse",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::${BUCKET}/bronze/*",
        "arn:aws:s3:::${BUCKET}/silver/*",
        "arn:aws:s3:::${BUCKET}/gold/*"
      ]
    },
    {
      "Sid": "ComprobarExistenciaParaInmutabilidadBronze",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${BUCKET}",
      "Condition": {"StringLike": {"s3:prefix": ["bronze/*", "silver/*", "gold/*"]}}
    },
    {
      "Sid": "EscribirLogsPropios",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/lambda/recolector-diario-bmv:*"
    }
  ]
}
